# Appwrite — the CMS backend.
#
#   1. Create a project at https://cloud.appwrite.io (or point at your own host).
#   2. Copy this file to .env.local and fill in the three values below.
#   3. Provision the database and tables:
#        node --env-file=.env.local scripts/setup-appwrite.mjs
#   4. Sign up on the site, then grant yourself review powers:
#        node --env-file=.env.local scripts/setup-appwrite.mjs --superadmin you@example.com

# Appwrite Cloud, or your self-hosted endpoint (must end in /v1).
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Settings -> Project ID in the Appwrite console.
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Overview -> Integrations -> API keys -> Create API key.
# Scopes needed: databases.*, tables.*, documents.*, buckets.*, files.*,
# users.* and sessions.write. That last one is easy to miss and is what
# lets the server sign somebody in the moment they create an account —
# without it, signup fails with a 401 and nothing else looks wrong.
# Server-side only — this must never be prefixed NEXT_PUBLIC_.
APPWRITE_API_KEY=

# The public origin, used to turn the relative canonical and Open Graph URLs
# into absolute ones. Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://glitchdecoded.example

# --- Cloudflare R2 — where uploaded pictures live -----------------------------
# Article covers and the board's note pictures are stored here. Set up at
# https://dash.cloudflare.com -> R2:
#
#   1. Create a bucket.
#   2. Give it a public custom domain (R2 -> your bucket -> Settings -> Public
#      access -> Custom domains). The r2.dev subdomain is rate-limited and
#      Cloudflare says not to use it in production.
#   3. Manage API tokens -> Create token -> Object Read & Write, scoped to
#      that one bucket. That yields the two keys below.
#
# Note that R2 enforces no size or type limit of its own, unlike the Appwrite
# bucket this replaced: the checks in src/lib/storage/config.ts are the only
# ones there are, and next.config.ts must let a file that large through.

# R2 -> Overview, right-hand sidebar.
R2_ACCOUNT_ID=

# The bucket's name.
R2_BUCKET=

# From the Object Read & Write token. Server-side only — neither of these may
# ever be prefixed NEXT_PUBLIC_.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket's public custom domain, no trailing slash. This is what readers
# load covers from, so it must be the public domain and not the
# *.r2.cloudflarestorage.com endpoint — that one answers signed requests only
# and would 401 for every signed-out reader.
R2_PUBLIC_URL=https://img.example.com

# --- The room ---------------------------------------------------------------
# OpenAI API key, which powers the writing companion on the dashboard — the
# panel beside the editor and /dashboard/companion. Get one at
# https://platform.openai.com -> API keys.
#
# Server-side only: it is read in a Route Handler and must never be prefixed
# NEXT_PUBLIC_. Leave it unset and the rest of the CMS works exactly as before;
# the panel simply says the companion isn't switched on.
OPENAI_API_KEY=

# Optional. Which model answers. The default is a mini tier, chosen to keep the
# running cost down; this is the knob to turn if the companion feels shallow.
# OPENAI_MODEL=gpt-5.4
